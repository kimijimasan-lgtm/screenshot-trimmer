# 個人の検証用動画（ソースコードと無関係、約1.1GB）
実験結果動画/

# 開発関連の一般的な除外
node_modules/
.env
.env.*
*.log
.DS_Store
Thumbs.db

# 機密情報（APIキー等）を書き出す可能性のあるローカル設定ファイル
*.local
secrets.json

# Python が自動で作るキャッシュ（テスト用サーバーの起動などで作られる）
__pycache__/

# ビルド関連（出力先はプロジェクトの外だが、万が一のための安全策）
build/
dist/
*.exe
*.zip

# yt-dlp のスタンドアロン版（同梱用。プロジェクトには置かない）
yt-dlp.exe

# ポート変更ファイル（テスト用）
port.txt
